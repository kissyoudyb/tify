<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.phadcalc.llm.tify</groupId>
        <artifactId>tify</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>tify-mcp</artifactId>
    <packaging>jar</packaging>
    <name>tify-mcp</name>
    <description>MCP tool management and invocation</description>

    <dependencies>
        <!-- tify-common -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-common</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MCP Java SDK - 官方协议层，只做序列化/反序列化和请求响应 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <version>1.1.1</version>
            <exclusions>
                <!-- 默认引入 mcp-json-jackson3，会拉 tools.jackson.core:jackson-databind:3.0.3
                     与 Spring 6.2.x 自带的 jackson 2.x 冲突（NoSuchMethodError on JsonProperty.isRequired）。
                     显式排除，引入 jackson2 版本走 Spring 自带的 ObjectMapper。-->
                <exclusion>
                    <groupId>io.modelcontextprotocol.sdk</groupId>
                    <artifactId>mcp-json-jackson3</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 强制使用 jackson2 版本的 mapper，SPI 会自动加载 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>1.1.1</version>
        </dependency>
    </dependencies>

</project>
