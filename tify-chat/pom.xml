<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.phadcalc.llm.tify</groupId>
        <artifactId>tify</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>tify-chat</artifactId>
    <packaging>jar</packaging>
    <name>tify-chat</name>
    <description>Conversation engine with streaming, multi-turn and context management</description>

    <dependencies>
        <!-- tify-common -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-common</artifactId>
        </dependency>

        <!-- tify-agent (read agent config) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-agent</artifactId>
        </dependency>

        <!-- tify-provider (read model config) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-provider</artifactId>
        </dependency>

        <!-- tify-workflow (trigger workflows) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-workflow</artifactId>
        </dependency>

        <!-- tify-knowledge (RAG retrieval) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-knowledge</artifactId>
        </dependency>

        <!-- tify-mcp (tool calling) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-mcp</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Resilience4j (circuit breaker per provider) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
