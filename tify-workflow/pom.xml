<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.phadcalc.llm.tify</groupId>
        <artifactId>tify</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>tify-workflow</artifactId>
    <packaging>jar</packaging>
    <name>tify-workflow</name>
    <description>Workflow orchestration and execution</description>

    <dependencies>
        <!-- tify-common -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-common</artifactId>
        </dependency>

        <!-- tify-provider (LLM 调用) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-provider</artifactId>
        </dependency>

        <!-- tify-knowledge (RAG 检索) -->
        <dependency>
            <groupId>com.phadcalc.llm.tify</groupId>
            <artifactId>tify-knowledge</artifactId>
        </dependency>

        <!-- OkHttp (API_CALL 节点) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL Connector -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
